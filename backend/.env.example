# Copy to .env and fill in values (Neon Cloud PostgreSQL)
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xyz-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:YOUR_PASSWORD@ep-xyz.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Clinic settings
CLINIC_NAME=AyurSutra Panchakarma Centre
CLINIC_OPEN_TIME=08:00
CLINIC_CLOSE_TIME=20:00

# PDF output directory
PDF_OUTPUT_DIR=./generated_pdfs
